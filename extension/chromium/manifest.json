{
  "manifest_version": 3,
  "name": "Black Forest Desk",
  "version": "0.1.45",
  "description": "AllData Create R/O \u2192 Labels print, plus SSF checkout On-the-Lot last-name helper.",
  "permissions": [
    "storage",
    "alarms",
    "cookies",
    "tabs",
    "idle",
    "downloads"
  ],
  "host_permissions": [
    "https://manageonline.alldata.com/*",
    "https://ssfautoparts.com/*",
    "https://www.ssfautoparts.com/*",
    "https://shop.blackforestautomotive.com/*",
    "https://raw.githubusercontent.com/*",
    "https://github.com/BlackForestPorsche/label-connect/*",
    "http://127.0.0.1:8080/*",
    "http://127.0.0.1/*",
    "http://localhost:8080/*",
    "http://localhost/*",
    "https://release-assets.githubusercontent.com/*",
    "https://objects.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/desk-16.png",
    "32": "icons/desk-32.png",
    "48": "icons/desk-48.png",
    "128": "icons/desk-128.png"
  },
  "action": {
    "default_title": "Black Forest Desk",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/desk-16.png",
      "32": "icons/desk-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://manageonline.alldata.com/*"
      ],
      "js": [
        "config.js",
        "scrape.js",
        "toast.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://ssfautoparts.com/*",
        "https://www.ssfautoparts.com/*"
      ],
      "js": [
        "config.js",
        "toast.js",
        "lot-names.js",
        "content-ssf.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://shop.blackforestautomotive.com/*"
      ],
      "js": [
        "content-shop.js"
      ],
      "run_at": "document_start"
    }
  ]
}
