{
  "manifest_version": 3,
  "name": "Black Forest Desk",
  "version": "0.1.7",
  "description": "AllData Create R/O → Labels print, plus SSF checkout On-the-Lot last-name helper.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://manageonline.alldata.com/*",
    "https://ssfautoparts.com/*",
    "https://www.ssfautoparts.com/*",
    "https://shop.blackforestautomotive.com/*",
    "https://raw.githubusercontent.com/*",
    "http://127.0.0.1:8080/*",
    "http://127.0.0.1/*",
    "http://localhost:8080/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Black Forest Desk",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://manageonline.alldata.com/*"],
      "js": ["config.js", "scrape.js", "toast.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://ssfautoparts.com/*",
        "https://www.ssfautoparts.com/*"
      ],
      "js": ["config.js", "toast.js", "lot-names.js", "content-ssf.js"],
      "run_at": "document_idle"
    }
  ]
}
