{
  "manifest_version": 3,
  "name": "Black Forest Desk",
  "version": "0.1.55",
  "description": "Prints a label when you create a repair order in AllData, keeps the shop site and Tools signed in together, and fills the SSF order reference from On the Lot.",
  "browser_specific_settings": {
    "gecko": {
      "id": "black-forest-desk@blackforestautomotive.com",
      "strict_min_version": "140.0",
      "update_url": "https://github.com/BlackForestPorsche/label-connect/releases/download/desk-extension/updates.json",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "storage",
    "alarms",
    "cookies",
    "tabs",
    "scripting",
    "idle",
    "downloads"
  ],
  "host_permissions": [
    "https://manageonline.alldata.com/*",
    "https://ssfautoparts.com/*",
    "https://www.ssfautoparts.com/*",
    "https://shop.blackforestautomotive.com/*",
    "https://raw.githubusercontent.com/*",
    "https://github.com/BlackForestPorsche/label-connect/*",
    "https://api2.cursor.sh/*",
    "http://127.0.0.1:8080/*",
    "http://127.0.0.1/*",
    "http://localhost:8080/*",
    "http://localhost/*",
    "https://release-assets.githubusercontent.com/*",
    "https://objects.githubusercontent.com/*"
  ],
  "background": {
    "scripts": [
      "config.js",
      "lot-names.js",
      "background.js"
    ]
  },
  "icons": {
    "16": "icons/desk-16.png",
    "32": "icons/desk-32.png",
    "48": "icons/desk-48.png",
    "128": "icons/desk-128.png"
  },
  "action": {
    "default_title": "Black Forest Desk",
    "default_icon": {
      "16": "icons/desk-16.png",
      "32": "icons/desk-32.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://manageonline.alldata.com/*"
      ],
      "js": [
        "config.js",
        "scrape.js",
        "toast.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://ssfautoparts.com/*",
        "https://www.ssfautoparts.com/*"
      ],
      "js": [
        "config.js",
        "toast.js",
        "lot-names.js",
        "content-ssf.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://shop.blackforestautomotive.com/*"
      ],
      "js": [
        "content-shop.js"
      ],
      "run_at": "document_start"
    }
  ]
}
