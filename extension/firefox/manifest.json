{
  "manifest_version": 3,
  "name": "Black Forest Desk",
  "version": "0.1.19",
  "description": "AllData Create R/O \u2192 Labels print, plus SSF checkout On-the-Lot last-name helper.",
  "browser_specific_settings": {
    "gecko": {
      "id": "black-forest-desk@blackforestautomotive.com",
      "strict_min_version": "140.0",
      "update_url": "https://github.com/BlackForestPorsche/label-connect/releases/download/desk-extension/updates.json",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "alarms",
    "cookies",
    "tabs",
    "idle",
    "downloads"
  ],
  "host_permissions": [
    "https://manageonline.alldata.com/*",
    "https://ssfautoparts.com/*",
    "https://www.ssfautoparts.com/*",
    "https://shop.blackforestautomotive.com/*",
    "https://raw.githubusercontent.com/*",
    "https://github.com/BlackForestPorsche/label-connect/*",
    "http://127.0.0.1:8080/*",
    "http://127.0.0.1/*",
    "http://localhost:8080/*",
    "http://localhost/*"
  ],
  "background": {
    "scripts": [
      "config.js",
      "lot-names.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "Black Forest Desk",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://manageonline.alldata.com/*"
      ],
      "js": [
        "config.js",
        "scrape.js",
        "toast.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://ssfautoparts.com/*",
        "https://www.ssfautoparts.com/*"
      ],
      "js": [
        "config.js",
        "toast.js",
        "lot-names.js",
        "content-ssf.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://shop.blackforestautomotive.com/*"
      ],
      "js": [
        "content-shop.js"
      ],
      "run_at": "document_start"
    }
  ]
}
